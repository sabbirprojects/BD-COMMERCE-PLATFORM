{
  "name": "bd-commerce-platform",
  "version": "1.0.0",
  "description": "High-Performance B2C E-Commerce Platform for Bangladesh Market",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:medusa": "npm run dev --workspace=apps/medusa",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:medusa": "npm run build --workspace=apps/medusa",
    "start:medusa": "npm run start --workspace=apps/medusa",
    "medusa:migrate": "npm run migrate --workspace=apps/medusa",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/api",
    "prisma:studio": "npm run prisma:studio --workspace=apps/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps"
  },
  "keywords": [
    "ecommerce",
    "nextjs",
    "nestjs",
    "prisma",
    "postgresql",
    "redis",
    "meilisearch"
  ],
  "author": "",
  "license": "ISC"
}
