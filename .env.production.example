# ==============================================================================
# BD COMMERCE PLATFORM - PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
#
# INSTRUCTIONS FOR PRODUCTION DEPLOYMENT:
# 1. Do NOT store real production secrets in plaintext files on developer machines.
# 2. Inject environment variables via your cloud Secret Manager / Orchestrator:
#    - AWS Secrets Manager / ECS SSM Parameter Store
#    - HashiCorp Vault
#    - Doppler / Infisical
#    - Kubernetes Secrets / Docker Swarm Secrets
# 3. Mount Nagad RSA private key as a read-only filesystem volume with mode 0600.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Production Runtime & Network
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=9000
WEB_PORT=3000
MEDUSA_PORT=9000
HOSTNAME="0.0.0.0"

# Canonical Production URLs
MEDUSA_BACKEND_URL=https://api.yourdomain.com
STORE_URL=https://yourdomain.com
ADMIN_URL=https://admin.yourdomain.com

# ------------------------------------------------------------------------------
# 2. Production CORS Origins (Strict allowlist - No wildcards allowed)
# ------------------------------------------------------------------------------
STORE_CORS=https://yourdomain.com,https://www.yourdomain.com
ADMIN_CORS=https://admin.yourdomain.com
AUTH_CORS=https://yourdomain.com,https://admin.yourdomain.com

# ------------------------------------------------------------------------------
# 3. Managed PostgreSQL 16 (Private VPC Network)
# Example Vault: vault:secret/data/production/database#url
# ------------------------------------------------------------------------------
POSTGRES_USER=bd_commerce_prod_user
POSTGRES_PASSWORD=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/db_password
POSTGRES_DB=bd_commerce
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bd_commerce_prod_user:SECRET_FROM_VAULT@postgres.internal.vpc:5432/bd_commerce?sslmode=require

# ------------------------------------------------------------------------------
# 4. Managed Redis 7 (Private VPC Network, TLS enabled)
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/redis_password
REDIS_URL=rediss://:SECRET_FROM_VAULT@redis.internal.vpc:6379

# ------------------------------------------------------------------------------
# 5. Meilisearch v1.11 (Internal VPC Network)
# ------------------------------------------------------------------------------
MEILISEARCH_PORT=7700
MEILISEARCH_URL=http://meilisearch:7700
MEILI_MASTER_KEY=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/meili_master
MEILI_ENV=production
# Search-only public key provisioned for frontend
NEXT_PUBLIC_MEILISEARCH_URL=https://search.yourdomain.com
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=pk_prod_search_only_meilisearch_key

# ------------------------------------------------------------------------------
# 6. Medusa Authentication & Security Secrets (Generated with: openssl rand -hex 32)
# ------------------------------------------------------------------------------
JWT_SECRET=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/jwt_secret
COOKIE_SECRET=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/cookie_secret
MEDUSA_ADMIN_EMAIL=security@yourdomain.com
MEDUSA_ADMIN_PASSWORD=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/initial_admin_pwd

# ------------------------------------------------------------------------------
# 7. Next.js 15 Storefront Public Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.yourdomain.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_prod_from_medusa_admin_publishable_keys
NEXT_PUBLIC_META_PIXEL_ID=987654321098765

# ------------------------------------------------------------------------------
# 8. bKash Direct Merchant PGW (Live Production Credentials)
# ------------------------------------------------------------------------------
BKASH_APP_KEY=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/bkash_app_key
BKASH_APP_SECRET=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/bkash_app_secret
BKASH_USERNAME=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/bkash_username
BKASH_PASSWORD=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/bkash_password
BKASH_SANDBOX=false

# ------------------------------------------------------------------------------
# 9. Nagad Direct Merchant PGW (Live Production Credentials & Key Isolation)
# Security Rule C-5: Nagad private key MUST be read from a file path with 0600 permissions.
# ------------------------------------------------------------------------------
NAGAD_MERCHANT_ID=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/nagad_merchant_id
NAGAD_PRIVATE_KEY_PATH=/etc/secrets/nagad_private.pem
NAGAD_PUBLIC_KEY_PATH=/etc/secrets/nagad_public.pem
NAGAD_SANDBOX=false
# Host filesystem path mounted read-only into container (:ro)
NAGAD_KEY_HOST_PATH=/opt/secrets/nagad_private.pem

# ------------------------------------------------------------------------------
# 10. Courier Logistics Integration (Live Production APIs)
# ------------------------------------------------------------------------------
STEADFAST_API_KEY=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/steadfast_key
STEADFAST_API_SECRET=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/steadfast_secret
PATHAO_CLIENT_ID=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/pathao_client_id
PATHAO_CLIENT_SECRET=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/pathao_client_secret

# ------------------------------------------------------------------------------
# 11. SMS Gateway (Live Approved Sender ID)
# ------------------------------------------------------------------------------
SMS_PROVIDER=greenweb
SMS_API_KEY=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/greenweb_token
SMS_SENDER_ID=BRANDNAME

# ------------------------------------------------------------------------------
# 12. Automated Disaster Recovery & Offsite Cloud Storage
# ------------------------------------------------------------------------------
BACKUP_DIR=/var/backups/postgres
BACKUP_ENCRYPTION_KEY=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:prod/backup_passphrase
RETENTION_DAYS=30
S3_BUCKET=bd-commerce-production-encrypted-backups
S3_REGION=ap-southeast-1
