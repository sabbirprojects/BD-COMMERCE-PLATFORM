# ==============================================================================
# BD COMMERCE PLATFORM - ENVIRONMENT CONFIGURATION (TEMPLATE)
#
# No real secrets belong in this file. Copy to `.env` (repo root for
# docker-compose, apps/medusa/.env for the Medusa server) and fill in
# strong random values locally. Never commit `.env`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Environment & Ports
# ------------------------------------------------------------------------------
NODE_ENV=development
# Legacy NestJS API (apps/api) — kept running until it is retired by the
# prompt plan. Not used by the Medusa engine.
API_PORT=4000
# Medusa v2 Commerce Engine & Admin (apps/medusa)
MEDUSA_PORT=9000
MEDUSA_BACKEND_URL=http://localhost:9000
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. PostgreSQL (docker-compose) & Connection URL
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=bd_commerce
POSTGRES_PORT=5432

# Medusa + Prisma (apps/api) connection string.
DATABASE_URL="postgresql://postgres:your_secure_postgres_password@localhost:5432/bd_commerce?schema=public"

# ------------------------------------------------------------------------------
# 3. Redis Cache & Event Bus
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password
REDIS_URL="redis://:your_secure_redis_password@localhost:6379"

# ------------------------------------------------------------------------------
# 4. Meilisearch Instant Search Engine (docker-compose)
# ------------------------------------------------------------------------------
MEILISEARCH_PORT=7700
MEILI_MASTER_KEY=your_secure_meilisearch_master_key
MEILI_ENV=development
# Reserved for the meilisearch plugin (registered in a later prompt):
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_API_KEY=your_secure_meilisearch_master_key

# ------------------------------------------------------------------------------
# 5. Medusa Auth Secrets
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_min_64_chars
COOKIE_SECRET=your_medusa_cookie_secret_min_32_chars
# Optional TOTP encryption key for admin MFA (32 bytes, hex).
AUTH_MFA_ENCRYPTION_KEY=your_32_byte_hex_key

# ------------------------------------------------------------------------------
# 6. File Storage (S3-compatible) — used when the S3 file provider is
#    registered in a later prompt; not active yet.
# ------------------------------------------------------------------------------
# S3_REGION=ap-southeast-1
# S3_BUCKET=bd-commerce-assets
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key
# S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com

# ------------------------------------------------------------------------------
# 7. Nagad Payment Gateway — used by the Phase 3 (payments) prompt.
#    Private key is read from a file path; the key file itself is never
#    stored in the repo or in environment variables.
# ------------------------------------------------------------------------------
# NAGAD_BASE_URL=https://api.mynagad.com/remote-payment-gateway-1.0/api/dfs
# NAGAD_MERCHANT_ID=your_nagad_merchant_id
# NAGAD_PRIVATE_KEY_PATH=/run/secrets/nagad_private_key.pem
