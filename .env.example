# ==============================================================================
# BD COMMERCE PLATFORM - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
#
# This template catalogs ALL environment variables utilized across the platform.
# For local development: copy this file to `.env` and fill in local development values.
# For production: see `.env.production.example` for secret manager guidance.
# CRITICAL: Never commit `.env` or production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Runtime & Ports
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=9000
WEB_PORT=3000
MEDUSA_PORT=9000
MEDUSA_BACKEND_URL=http://localhost:9000

# ------------------------------------------------------------------------------
# 2. CORS Origins (Comma-separated URLs without trailing slashes)
# ------------------------------------------------------------------------------
STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:3000

# ------------------------------------------------------------------------------
# 3. PostgreSQL 16 Database
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_development_pass
POSTGRES_DB=bd_commerce
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_secure_development_pass@localhost:5432/bd_commerce

# ------------------------------------------------------------------------------
# 4. Redis 7 Cache & BullMQ Queue
# ------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass
REDIS_URL=redis://:redis_secure_pass@localhost:6379

# ------------------------------------------------------------------------------
# 5. Meilisearch v1.11 Catalog Search
# ------------------------------------------------------------------------------
MEILISEARCH_PORT=7700
MEILISEARCH_URL=http://localhost:7700
MEILI_MASTER_KEY=meili_master_key_secret_12345
MEILI_ENV=development
# Public search-only API key generated for storefront
NEXT_PUBLIC_MEILISEARCH_URL=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=your_search_only_public_key

# ------------------------------------------------------------------------------
# 6. Medusa Authentication & Security Secrets (Generate using: openssl rand -hex 32)
# ------------------------------------------------------------------------------
JWT_SECRET=development_jwt_secret_minimum_64_characters_random_string_123456789
COOKIE_SECRET=development_cookie_secret_minimum_32_characters_random_string_123
MEDUSA_ADMIN_EMAIL=admin@yourdomain.com
MEDUSA_ADMIN_PASSWORD=SuperAdminDev2026!

# ------------------------------------------------------------------------------
# 7. Next.js 15 Storefront Public Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_your_medusa_publishable_api_key
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# ------------------------------------------------------------------------------
# 8. bKash Direct Merchant PGW (Checkout & Webhooks)
# ------------------------------------------------------------------------------
BKASH_APP_KEY=your_bkash_sandbox_app_key
BKASH_APP_SECRET=your_bkash_sandbox_app_secret
BKASH_USERNAME=sandbox_merchant_user
BKASH_PASSWORD=sandbox_merchant_password
BKASH_SANDBOX=true

# ------------------------------------------------------------------------------
# 9. Nagad Direct Merchant PGW (RSA Key Isolation - Rule C-5)
# ------------------------------------------------------------------------------
NAGAD_MERCHANT_ID=683002007104225
# Nagad private key MUST be read from a file path with 0600 permissions.
# Never store raw private key text in environment variables!
NAGAD_PRIVATE_KEY_PATH=./config/keys/nagad_private.pem
NAGAD_PUBLIC_KEY_PATH=./config/keys/nagad_public.pem
NAGAD_SANDBOX=true
# Host path for Docker mount
NAGAD_KEY_HOST_PATH=./config/keys/nagad_private.pem

# ------------------------------------------------------------------------------
# 10. Courier Logistics Integration
# ------------------------------------------------------------------------------
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_API_SECRET=your_steadfast_secret_key
PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret

# ------------------------------------------------------------------------------
# 11. SMS Gateway (BullMQ async dispatcher)
# ------------------------------------------------------------------------------
SMS_PROVIDER=greenweb
SMS_API_KEY=your_greenweb_api_token
SMS_SENDER_ID=BDCOMMERCE

# ------------------------------------------------------------------------------
# 12. Automated Backup & Disaster Recovery
# ------------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_ENCRYPTION_KEY=your_aes256_cbc_backup_passphrase
RETENTION_DAYS=30
# S3_BUCKET=your-cloud-backup-bucket
