# ==============================================================================
# BD COMMERCE PLATFORM - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Environment & Ports
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. PostgreSQL Configuration & Connection URLs
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=bd_commerce
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Prisma Primary Database URL
DATABASE_URL="postgresql://postgres:your_secure_postgres_password@localhost:5432/bd_commerce?schema=public"
DIRECT_URL="postgresql://postgres:your_secure_postgres_password@localhost:5432/bd_commerce?schema=public"

# ------------------------------------------------------------------------------
# 3. Redis Cache & Message Queue
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password
REDIS_URL="redis://:your_secure_redis_password@localhost:6379"

# ------------------------------------------------------------------------------
# 4. Meilisearch Instant Search Engine
# ------------------------------------------------------------------------------
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_PORT=7700
MEILI_MASTER_KEY=your_secure_meilisearch_master_key
MEILI_ENV=development

# ------------------------------------------------------------------------------
# 5. Cryptographic Keys & Authentication Secrets
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_min_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_64_chars
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=your_session_secret_32_bytes
ENCRYPTION_KEY=your_aes_256_encryption_key_32_bytes_hex
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Bangladesh Payment Gateways (Sandbox / Developer API)
# ------------------------------------------------------------------------------

# bKash Tokenized Checkout (Sandbox)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v2.0
BKASH_APP_KEY=sandbox_bkash_app_key_test_01
BKASH_APP_SECRET=sandbox_bkash_app_secret_test_99214
BKASH_USERNAME=sandbox_tokenized_user
BKASH_PASSWORD=sandbox_tokenized_pass
BKASH_CALLBACK_URL=http://localhost:4000/api/v1/payments/bkash/callback

# Nagad PGW (Sandbox)
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs
NAGAD_MERCHANT_ID=683002007104225
NAGAD_PUBLIC_KEY=sandbox_nagad_public_key_mock_2026
NAGAD_PRIVATE_KEY=sandbox_nagad_private_key_mock_2026
NAGAD_CALLBACK_URL=http://localhost:4000/api/v1/payments/nagad/callback

# SSLCommerz Payment Gateway (Sandbox)
SSLCOMMERZ_STORE_ID=bdcomm_sandbox_store
SSLCOMMERZ_STORE_PASSWD=bdcomm_sandbox_secret
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_SESSION_API=https://sandbox.sslcommerz.com/gwprocess/v4/api.php
SSLCOMMERZ_VALIDATION_API=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
SSLCOMMERZ_SUCCESS_URL=http://localhost:3000/checkout/success
SSLCOMMERZ_FAIL_URL=http://localhost:3000/checkout/failed
SSLCOMMERZ_CANCEL_URL=http://localhost:3000/checkout/cancelled
SSLCOMMERZ_IPN_URL=http://localhost:4000/api/v1/payments/sslcommerz/ipn
